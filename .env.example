# mediaflow-web env variables
# Leave empty so the browser uses relative paths (/api/v1/...) through the nginx proxy.
# Set to the full public URL (e.g. https://example.com) only when building a
# standalone image that does NOT go through this nginx reverse proxy.
PUBLIC_API_BASE_URL=
PUBLIC_APP_PORT=80
PUBLIC_APP_NAME=MediaFlow
NODE_ENV=development

# mediaflow-api env variables
# Database
DATABASE_URL=postgresql+asyncpg://mediaflow:mediaflow@db:5432/mediaflow
POSTGRES_USER=mediaflow
POSTGRES_PASSWORD=mediaflow
POSTGRES_DB=mediaflow

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (swap MINIO_ENDPOINT for your S3 endpoint to use AWS S3 instead)
MINIO_ENDPOINT=minio:9000
# Public endpoint used in presigned URLs — hostname[:port] exactly as the browser
# reaches the app (no scheme). Port 80 can be omitted; any other port must be included
# because MinIO embeds it in the HMAC signature and nginx forwards it via Host header.
# Prod port 80: yourdomain.com  |  Prod port 443: yourdomain.com (nginx handles TLS)
# Dev port 8080: localhost:8080
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mediaflow
MINIO_SECURE=false
PRESIGNED_URL_EXPIRE=3600

# JWT — generate a strong secret: openssl rand -hex 32
SECRET_KEY=c2b21a82c3abaaced2d847f540299cf55af95b5f7535ccf8b36007f35790c2c2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload limits
MAX_UPLOAD_SIZE_MB=500

# CORS — comma separated or JSON list
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","http://localhost:4321","http://mediaflow.test","https://mediaflow.test"]

# SMTP — optional, for job-completion email notifications. Leave SMTP_HOST blank to disable.
# Port 587 + SMTP_TLS=true  → STARTTLS (recommended for Gmail, Outlook, etc.)
# Port 465 + SMTP_TLS=false → SMTP over SSL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Workers (informational — set via docker compose scale)
CELERY_WORKERS=2

# Debug
DEBUG=false

# Exposed ports (host-side — change if you have conflicts)
# API_PORT is no longer required externally when using the nginx proxy,
# but is kept for direct access / dev overrides.
API_PORT=8000
DB_PORT=5433
REDIS_PORT=6380
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
